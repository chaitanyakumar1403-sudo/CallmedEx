# ==============================================================================
# CALLMEDEX BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# ==============================================================================

# ─── 1. ENVIRONMENT ARCHITECTURE [REQUIRED] ───────────────────────────────────
# Mode: development | staging | production
APP_ENV=development
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://callmedex-frontend.vercel.app,https://staging-api.callmedex.com

# ─── 2. SUPABASE DATABASE & AUTH [REQUIRED] ──────────────────────────────────
# Staging/Production must use their own dedicated Supabase instances
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ─── 3. AUTHENTICATION & TOKEN SECURITY [REQUIRED] ───────────────────────────
# Must be at least 32 random bytes (e.g., openssl rand -hex 32)
JWT_SECRET=your-secure-jwt-secret-min-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_TOKEN_SECRET=your-email-token-secret
MAGIC_LINK_SECRET=your-magic-link-secret
TASK_SESSION_SECRET=your-task-session-secret

# ─── 4. REDIS CACHING & RATE LIMITING [REQUIRED] ─────────────────────────────
# Local: redis://localhost:6379/0 | Cloud: rediss://default:password@host:port
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=60

# ─── 5. AI SERVICES (OCR, Analysis, Medical Verification) [REQUIRED] ─────────
GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_VISION_MODEL=qwen/qwen3.7-flash
OPENROUTER_ANALYSIS_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-v4-pro
GROQ_API_KEY=your-groq-api-key-optional

# ─── 6. GEOLOCATION & MAPS (Geoapify) [REQUIRED] ─────────────────────────────
GEOAPIFY_API_KEY=your-geoapify-api-key

# ─── 7. RAZORPAY PAYMENT GATEWAY [REQUIRED FOR PAYMENTS] ──────────────────────
# Test Mode: rzp_test_... | Live Mode: rzp_live_...
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
ENABLE_DEV_MOCK_PAYMENT=false # true only in local development when keys absent

# ─── 8. MSG91 SMS OTP GATEWAY [REQUIRED FOR PHONE AUTH] ───────────────────────
# OTP_PROVIDER: msg91 (default) | mock (allowed only when APP_ENV=development)
OTP_PROVIDER=msg91
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_dlt_approved_template_id
MSG91_SENDER_ID=CLMDEX
MSG91_OTP_LENGTH=6
MSG91_OTP_EXPIRY_MINUTES=5
# DLT-registered notification SMS template (format: "CallMedex: ##VAR1##")
MSG91_FLOW_ID=your_msg91_dlt_flow_id

# ─── 9. TELEMEDICINE VIDEO (Daily.co) [REQUIRED FOR VIDEO CALLS] ──────────────
DAILY_API_KEY=your-daily-co-rest-api-key

# ─── 10. EMAIL NOTIFICATIONS (Resend / SMTP) [REQUIRED FOR NOTIFICATIONS] ─────
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=support@mail.callmedex.com
SMTP_FROM_EMAIL=support@mail.callmedex.com

# ─── 11. MEDIASSIST INTEGRATION [FROZEN CONTRACT] ────────────────────────────
MEDIASSIST_BASE_URL=https://mediassist.callmedex.com
MEDIASSIST_BEARER_TOKEN=your-outbound-bearer-token
MEDIASSIST_INBOUND_BEARER_TOKEN=your-inbound-bearer-token
MEDIASSIST_HMAC_SECRET=your-shared-hmac-sha256-secret
CALLMEDEX_PUBLIC_BASE_URL=https://staging-api.callmedex.com

# ─── 12. PUSH NOTIFICATIONS & MOBILE [OPTIONAL] ──────────────────────────────
MOBILE_BUNDLE_ID=com.callmedex.app
BIOMETRIC_CHALLENGE_SECRET=your-biometric-secret-or-leave-blank-for-jwt-secret

# Android Push (Firebase Cloud Messaging HTTP v1)
# Paste the whole service-account JSON contents
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
FCM_PROJECT_ID=optional_project_id_if_not_in_json

# iOS Push (Apple Push Notification service - APNs direct)
APNS_KEY_ID=your-10-char-key-id
APNS_TEAM_ID=your-10-char-team-id
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APNS_USE_SANDBOX=false

# ─── 13. FEATURE FLAGS [OPTIONAL] ────────────────────────────────────────────
ENABLE_PREVENTIVE_BIOMARKERS=true
ENABLE_DOCTOR_BRIEFING=true
ENABLE_FAMILY_SWIPER=true
ENABLE_EMERGENCY_SOS=true
ENABLE_SMART_MEDICINE_CABINET=true
ENABLE_PHLEBO_RADAR=true
VERIFICATION_AUTO_APPROVE=true
GOV_REGISTRY_MODE=off
