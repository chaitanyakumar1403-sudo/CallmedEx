# ==============================================================================
# CALLMEDEX MOBILE CLIENT ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# ==============================================================================
# Note: Mobile clients NEVER contain backend service keys, database passwords,
# or private API secrets. Only public API URLs and public client keys.

# ─── API GATEWAY URL ─────────────────────────────────────────────────────────
# Development:  http://10.0.2.2:8000 (Android) / http://localhost:8000 (iOS/Web)
# Staging:      https://staging-api.callmedex.com
# Production:   https://api.callmedex.com
EXPO_PUBLIC_API_URL=http://localhost:8000

# ─── ENVIRONMENT MODE ─────────────────────────────────────────────────────────
# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# ─── DAILY.CO TELEMEDICINE DOMAIN (PUBLIC) ───────────────────────────────────
EXPO_PUBLIC_DAILY_DOMAIN=callmedex.daily.co

# ─── RAZORPAY PUBLIC KEY (PUBLIC CLIENT KEY ONLY) ────────────────────────────
# Test Key: rzp_test_... | Production Key: rzp_prod_...
# (Private Secret Key stays ONLY on the backend!)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_public_key

# ─── SENTRY CRASH MONITORING [OPTIONAL] ───────────────────────────────────────
EXPO_PUBLIC_SENTRY_DSN=https://your_sentry_dsn@ingest.sentry.io/project
